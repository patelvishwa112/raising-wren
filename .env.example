# Copy to .env and fill in. Never commit .env.
# DeepSeek (teacher + judge). Either the Anthropic-format or OpenAI-format base URL works;
# src/teacher.py strips a trailing /anthropic and calls the OpenAI-compatible /chat/completions.
export DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
export DEEPSEEK_API_TOKEN=sk-your-deepseek-key
